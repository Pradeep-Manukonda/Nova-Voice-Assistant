# Assistant Settings
WAKE_WORD="hey assistant"
ASSISTANT_NAME="Nova"
LANGUAGE="en-US"

# Speech Synthesis (TTS) Settings
TTS_ENGINE="pyttsx3" # Options: pyttsx3, gtts
VOICE_RATE=175
VOICE_VOLUME=1.0
VOICE_GENDER="female" # Options: male, female

# Speech Recognition (STT) Settings
STT_ENGINE="google" # Options: google, vosk
ENERGY_THRESHOLD=4000
DYNAMIC_ENERGY_THRESHOLD=True
LISTEN_TIMEOUT=5
PHRASE_TIME_LIMIT=10

# Email Credentials (Use App-Specific Password for Gmail)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
IMAP_SERVER="imap.gmail.com"
IMAP_PORT=993
EMAIL_ADDRESS="your_email@gmail.com"
EMAIL_PASSWORD="your_app_password"

# API Keys
OPENWEATHER_API_KEY="your_openweather_api_key"
NEWS_API_KEY="your_news_api_key"
DEFAULT_CITY="New York"
